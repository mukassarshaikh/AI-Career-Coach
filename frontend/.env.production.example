# =============================================================================
# Frontend Production Environment Variables Template (.env.production.example)
# =============================================================================

# --- Auth (NextAuth.js) ---
NEXTAUTH_URL=https://your-frontend-app.onrender.com
NEXTAUTH_SECRET=generate_a_random_32_byte_secret_here

# --- Backend API URLs ---
NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.onrender.com
BACKEND_URL=https://your-backend-api.onrender.com

# --- Environment ---
ENVIRONMENT=production
NODE_ENV=production

# --- Optional OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
